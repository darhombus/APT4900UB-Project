# Normalize all text files to LF in the repository, regardless of the
# contributor's OS. Prevents CRLF/LF churn and keeps CI (Prettier on Linux)
# consistent with local Windows checkouts.
* text=auto eol=lf

# Binary assets — never touch line endings
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.woff  binary
*.woff2 binary
