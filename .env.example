# Supabase — public (safe for the browser)
# ANON_KEY takes either the new publishable key (sb_publishable_...) or the
# legacy anon JWT — this project uses the new publishable/secret keys.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Supabase — server only. NEVER expose to the browser.
# Takes either the new secret key (sb_secret_...) or the legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
# Paystack (test keys during development; secret key stays server-side
# and also verifies webhook signatures)
PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Africa's Talking (sandbox)
AT_API_KEY=
AT_USERNAME=sandbox
# Resend
RESEND_API_KEY=
# App
PUBLIC_APP_URL=http://localhost:5173
