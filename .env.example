# Supabase — public (safe for the browser)
# ANON_KEY takes either the new publishable key (sb_publishable_...) or the
# legacy anon JWT — this project uses the new publishable/secret keys.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=
# Supabase — server only. NEVER expose to the browser.
# Takes either the new secret key (sb_secret_...) or the legacy service_role JWT.
SUPABASE_SERVICE_ROLE_KEY=
# Paystack (test keys during development; secret key stays server-side
# and also verifies webhook signatures)
PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
# Africa's Talking (sandbox)
AT_API_KEY=
AT_USERNAME=sandbox
# Resend
RESEND_API_KEY=
# App
PUBLIC_APP_URL=http://localhost:5173

# ── Local/test only — LEAVE UNSET, and never add either to Vercel ────────────
# Read at runtime via $env/dynamic/private, deliberately NOT in the static env
# schema (src/lib/server/env.ts), so no Vercel scope gains a build-time
# requirement for them.
#
# PAYSTACK_MOCK=1 swaps in the mock Paystack client: no network calls, and
# verify answers come from an in-memory registry the tests seed. It accepts
# fabricated payments, so getPaystackClient() THROWS if it ever sees this set
# while VERCEL is present.
# PAYSTACK_MOCK=1
#
# ORDER_HOLD_MINUTES overrides the 30-minute pending-order hold (D3). Tests set
# it to 1 so the expiry path is observable; unset means 30.
# ORDER_HOLD_MINUTES=30
